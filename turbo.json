{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "test": {
      "outputs": [],
      "env": [
        "DATABASE_URL_TESTE"
      ]
    }
  },
  "globalPassThroughEnv": [
    "PLAYWRIGHT_BROWSERS_PATH",
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "NO_PROXY",
    "NODE_EXTRA_CA_CERTS",
    "SSL_CERT_FILE"
  ]
}
