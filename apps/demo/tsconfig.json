{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"],
    "jsx": "preserve",
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/lib/fonte-dados": ["./demo/fonte-dados.ts"],
      "@/lib/contexto": ["./demo/contexto.ts"],
      "@/lib/contas/ativo": ["./demo/contas-ativo.ts"],
      "@/lib/email": ["./demo/email.ts"],
      "@/lib/avisos/ativo": ["./demo/avisos-ativo.ts"],
      "@/lib/gestao/ativo": ["./demo/gestao-ativo.ts"],
      "@/components/AtualizarSozinho": ["./demo/AtualizarSozinho.tsx"],
      "@/components/Indisponivel": ["./demo/Indisponivel.tsx"],
      "@/*": ["../web/*"],
      "@demo/*": ["./demo/*"]
    },
    "esModuleInterop": true
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", "demo/**/*.ts", "demo/**/*.tsx", "scripts/**/*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "out"]
}
