# Copie para .env e ajuste. NUNCA versione o .env.

# Banco e fila
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://radar:troque-esta-senha@localhost:5432/radar
REDIS_URL=redis://localhost:6379

# simulada = abertura simulada daqui a ~90 s (dev); fixture = arquivos de packages/core/fonte/fixtures;
# caixa-navegador = Marketplace real por navegador (Playwright), com sessão preparada por uma pessoa;
# caixa = esqueleto HTTP direto (não usar: o parâmetro q é cifrado pelo site). Ver docs/fonte-caixa.md
FONTE=simulada
FILA=bullmq            # ou memoria (sem Redis, só para dev)
REPOSITORIO=postgres   # ou memoria (sem banco, só para dev)
MIGRAR_NA_PARTIDA=true

# Relógio (vazio desliga o NTP)
NTP_SERVIDOR=a.ntp.br

# Modo abertura: T0 − 1 min até T0 + 60 min; 5 s até T0 + 30 min, depois 15 s
COLETA_INTERVALO_RAPIDO_MS=5000
COLETA_INTERVALO_LENTO_MS=15000
COLETA_ABERTURA_RAPIDA_MIN=30
COLETA_ABERTURA_DURACAO_MIN=60
COLETA_VARREDURA_NORMAL_MIN=5
COLETA_MAX_PAGINAS_ABERTURA=200
COLETA_MAX_PAGINAS_NORMAL=4000

# Adaptador caixa-navegador (conta DEDICADA da empresa; nunca a conta pessoal de alguém)
# Uma pessoa faz o login uma vez: pnpm caixa:preparar-sessao. A senha nunca é guardada.
CAIXA_CONTA_DEDICADA=true
# A vitrine vem em escopos: cidade da conta -> resto do estado -> resto do Brasil (21/11/2026).
# cidade = só a cidade (padrão); estado = segue para o resto da UF (Mega 3089: +89 páginas).
CAIXA_ESCOPOS=cidade
# Ordem dentro da fila para a colocação calculada: fila-chegada (hipótese atual) ou fila-aleatoria
# (a circular da CAIXA fala em ordem "aleatória"; validar com a gravação de uma abertura).
VITRINE_ORDEM=fila-chegada
CAIXA_SESSAO=.sessao-caixa/estado.json
# alternativa ao arquivo (ex.: VPS): base64 do estado.json
# CAIXA_SESSAO_JSON=
# Modo sem conta (FONTE=caixa-links): só os links públicos destas lotéricas
# CAIXA_LOTERICAS=990013,990020
CAIXA_INTERVALO_MS=3000
CAIXA_MODALIDADES=mega-sena,lotofacil,quina
CAIXA_HEADLESS=true

# Uso responsável da fonte: intervalo mínimo entre requisições HTTP
FONTE_INTERVALO_MIN_MS=250

# Simulação (FONTE=simulada)
# SIMULACAO_T0=2026-11-23T00:45:00Z
SIMULACAO_BOLOES=200

LOG_LEVEL=info

# Minha lotérica (web). Várias lojas separadas por vírgula; cada uma `código` ou `código=Nome`.
# O código vale em qualquer forma: 21.002894-7, 210028947, 002894 ou 2894 (forma do JSON da API).
# Legal Loterias (Vila Prudente, SP): acrescentar ", <código>=Legal Loterias" quando o código for informado.
RADAR_MINHA_LOTERICA=21.002894-7=Coli Loterias
RADAR_FRANQUIA_LIMITE=8000
# Contas (Fase 6): desligado | memoria | postgres. Sem a variável: postgres se houver DATABASE_URL
# (login obrigatório no painel; as lojas vêm da conta e RADAR_MINHA_LOTERICA deixa de valer); sem banco, desligado.
RADAR_AUTH=
# E-mails (link de acesso, convites, resumo semanal): console (padrão, escreve no log) ou smtp.
# Credenciais SÓ aqui no .env (nunca no repositório). Ex.: SMTP_URL=smtps://usuario:senha@smtp.exemplo.com:465
RADAR_EMAIL=console
SMTP_URL=
EMAIL_REMETENTE=Radar Lotérico <nao-responda@exemplo.com>
# Só em desenvolvimento local sem SMTP: mostra o link de acesso na tela (nunca em produção).
RADAR_EMAIL_LINK_NA_TELA=
# Site público (/{slug}): endereço base para SEO (canonical, sitemap) e dados de cada site (JSON).
# Com banco, a tela /minha/site grava na tabela `sites` (que vale mais que esta variável).
RADAR_SITE_URL=
RADAR_SITES=[{"codigo":"2894","slug":"coli-loterias","whatsapp":"","instagram":"","endereco":"","horario":"","tema":"classico"}]
