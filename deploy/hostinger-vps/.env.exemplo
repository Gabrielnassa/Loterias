# =====================================================================================================
# Radar Lotérico em produção (kit com SSH): copie para .env (o instalar.sh faz isso) e ajuste. NUNCA versione
# o .env. Os campos [gerado] o instalar.sh preenche sozinho se estiverem vazios. Explicação de cada variável
# (e o uso sem SSH, pelo Docker Manager da Hostinger): VARIAVEIS.md.
# =====================================================================================================

# --- Endereço -----------------------------------------------------------------------------------------
# Subdomínio do sistema. O DNS (registro A) precisa apontar para o IP do VPS ANTES de subir:
# o Caddy pede o certificado HTTPS (Let's Encrypt) para este nome.
DOMINIO=radar.nassatech.com.br
# E-mail para avisos do Let's Encrypt (vencimento de certificado etc.). Opcional.
EMAIL_ACME=

# --- Banco ---------------------------------------------------------------------------------------------
# [gerado] senha do Postgres (só letras e números; só usada entre os containers).
POSTGRES_PASSWORD=
# Backup diário (serviço backup, volume radar_backups): hora em UTC (06:30 = 03:30 em Brasília) e dias guardados
BACKUP_HORA_UTC=06:30
BACKUP_DIAS=14

# --- Coleta da vitrine da CAIXA ---------------------------------------------------------------------------
# simulada (padrão, até existir a sessão da conta dedicada; o painel avisa "dados simulados") |
# caixa-navegador (conta DEDICADA, sessão preparada por uma pessoa; LEIAME.md, passo 8) | caixa-links
# (sem conta: só os links públicos das lotéricas abaixo). Com caixa-*, o migrate apaga os dados fictícios.
FONTE=simulada
# true = grava UMA vez o histórico SIMULADO de demonstração (instalar.sh --seed); limpar = apaga
SEED_DEMO=false
# true = a sessão é de uma conta DEDICADA da empresa (nunca a conta pessoal de alguém)
CAIXA_CONTA_DEDICADA=true
# Sem arquivo de sessão (Docker Manager): a sessão em base64 (segredo!). Com SSH, use o preparar-sessao-vnc.sh.
CAIXA_SESSAO_JSON=
# Modalidades acompanhadas e até onde ler a lista (cidade | estado | brasil)
CAIXA_MODALIDADES=mega-sena,lotofacil,quina
CAIXA_ESCOPOS=cidade
# Ritmo mínimo entre páginas (ms): baixo e educado; não diminua sem motivo
CAIXA_INTERVALO_MS=3000
# Modo caixa-links: códigos das lotéricas monitoradas, separados por vírgula
CAIXA_LOTERICAS=
# Ordem dentro da fila: fila-chegada (padrão) | fila-aleatoria (decidir com pnpm analisar-abertura)
VITRINE_ORDEM=fila-chegada
# Busca o resultado oficial de cada concurso (API pública da CAIXA)
RESULTADOS_CAIXA=true
NTP_SERVIDOR=a.ntp.br
LOG_LEVEL=info

# --- E-mail (link de acesso, convites) -----------------------------------------------------------------
# console = só no log (dá para testar); smtp = envia de verdade
RADAR_EMAIL=console
# Ex.: smtps://usuario:senha@smtp.hostinger.com:465  (e-mail da própria Hostinger funciona)
SMTP_URL=
EMAIL_REMETENTE=Radar Lotérico <nao-responda@nassatech.com.br>

# --- Notificações (Web Push) ------------------------------------------------------------------------------
# Vazias = o migrate gera um par na 1ª subida e guarda no banco. Trocar depois invalida os aparelhos inscritos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Vazio = https://DOMINIO
VAPID_ASSUNTO=
# Alertas do worker (monitoradas, vendas, resultados, prêmios, previsão de zerar, resumo semanal)
ALERTAS=true

# --- Planos e cobrança (Asaas, SÓ SANDBOX nesta versão) ----------------------------------------------------
# Chave do sandbox: https://sandbox.asaas.com > Integrações. Vazio = cobrança simulada.
ASAAS_API_KEY=
# [gerado] token que você cadastra no webhook do Asaas (https://DOMINIO/api/webhooks/asaas)
ASAAS_WEBHOOK_TOKEN=
# livre = sem bloqueio de telas por plano (para usar só nas suas lojas, sem cobrar ninguém)
RADAR_PLANOS=livre

# --- Painel ---------------------------------------------------------------------------------------------
# Teto diário padrão da franquia (cada loja pode ter o seu em Equipe)
RADAR_FRANQUIA_LIMITE=8000
# Sites que podem mostrar o site público da lotérica e as páginas /embed em iframe (o WordPress),
# separados por espaço. Ex.: https://nassatech.com.br https://www.nassatech.com.br
RADAR_EMBED_ORIGENS=

# --- Imagens ---------------------------------------------------------------------------------------------
# Imagens prontas do GitHub Container Registry: latest ou o SHA de um commit (para fixar ou voltar uma versão)
RADAR_VERSAO=latest
RADAR_IMAGENS=ghcr.io/gabrielnassa
# Construir na própria VPS em vez de baixar (instalar.sh --construir grava esta linha):
# COMPOSE_FILE=docker-compose.yaml:docker-compose.build.yml
