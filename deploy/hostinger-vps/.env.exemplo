# =====================================================================================================
# Radar Lotérico em produção: copie para .env (o instalar.sh faz isso) e ajuste. NUNCA versione o .env.
# Os campos marcados com [gerado] o instalar.sh preenche sozinho se estiverem vazios.
# =====================================================================================================

# --- Endereço -----------------------------------------------------------------------------------------
# Subdomínio do sistema. O DNS (registro A) precisa apontar para o IP do VPS ANTES de subir:
# o Caddy pede o certificado HTTPS (Let's Encrypt) para este nome.
DOMINIO=radar.nassatech.com.br
# E-mail para avisos do Let's Encrypt (vencimento de certificado etc.).
EMAIL_ACME=

# --- Banco ---------------------------------------------------------------------------------------------
# [gerado] senha do Postgres (só usada entre os containers; o banco não fica exposto na internet).
POSTGRES_PASSWORD=

# --- Coleta da vitrine da CAIXA ---------------------------------------------------------------------------
# simulada (padrão, para conhecer o sistema) | caixa-navegador (conta DEDICADA, sessão preparada por uma
# pessoa; ver LEIAME.md, passo 8) | caixa-links (sem conta: só os links públicos das lotéricas abaixo)
FONTE=simulada
# true = a sessão é de uma conta DEDICADA da empresa (nunca a conta pessoal de alguém)
CAIXA_CONTA_DEDICADA=true
# Modalidades acompanhadas e até onde ler a lista (cidade | estado | brasil)
CAIXA_MODALIDADES=mega-sena,lotofacil,quina
CAIXA_ESCOPOS=cidade
# Ritmo mínimo entre páginas (ms): baixo e educado; não diminua sem motivo
CAIXA_INTERVALO_MS=3000
# Modo caixa-links: códigos das lotéricas monitoradas, separados por vírgula
CAIXA_LOTERICAS=
# Ordem dentro da fila: fila-chegada (padrão) | fila-aleatoria (decidir com pnpm analisar-abertura)
VITRINE_ORDEM=fila-chegada
# Busca o resultado oficial de cada concurso (API pública da CAIXA)
RESULTADOS_CAIXA=true
NTP_SERVIDOR=a.ntp.br
LOG_LEVEL=info

# --- E-mail (link de acesso, convites) -----------------------------------------------------------------
# console = só no log (dá para testar); smtp = envia de verdade
RADAR_EMAIL=console
# Ex.: smtps://usuario:senha@smtp.hostinger.com:465  (e-mail da própria Hostinger funciona)
SMTP_URL=
EMAIL_REMETENTE=Radar Lotérico <nao-responda@nassatech.com.br>

# --- Notificações (Web Push) ------------------------------------------------------------------------------
# [gerado] chaves VAPID. Trocar depois invalida os aparelhos já inscritos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ASSUNTO=mailto:contato@nassatech.com.br
# Alertas do worker (monitoradas, vendas, resultados, prêmios, previsão de zerar, resumo semanal)
ALERTAS=true

# --- Planos e cobrança (Asaas, SÓ SANDBOX nesta versão) ----------------------------------------------------
# Chave do sandbox: https://sandbox.asaas.com > Integrações. Vazio = cobrança simulada.
ASAAS_API_KEY=
# [gerado] token que você cadastra no webhook do Asaas (https://DOMINIO/api/webhooks/asaas)
ASAAS_WEBHOOK_TOKEN=
# livre = sem bloqueio de telas por plano (para usar só nas suas lojas, sem cobrar ninguém)
RADAR_PLANOS=livre

# --- Painel ---------------------------------------------------------------------------------------------
# Teto diário padrão da franquia (cada loja pode ter o seu em Equipe)
RADAR_FRANQUIA_LIMITE=8000
# Sites que podem mostrar o site público da lotérica e as páginas /embed em iframe (o WordPress),
# separados por espaço. Ex.: https://nassatech.com.br https://www.nassatech.com.br
RADAR_EMBED_ORIGENS=

# --- Imagens ---------------------------------------------------------------------------------------------
# Rótulo das imagens construídas no VPS
VERSAO=local
